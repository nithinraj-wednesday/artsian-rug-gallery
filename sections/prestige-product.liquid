      "blocks": [
        { "type": "title" },
        { "type": "prestige_price" },
        { "type": "variant_picker" },
        { "type": "prestige_shape_picker" },
        { "type": "prestige_buy_buttons" },
        { "type": "prestige_sample_atc" }
      ]
    }
  ]
}
{% endschema %}
