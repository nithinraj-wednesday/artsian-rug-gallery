          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h1",
          "options": [
            { "value": "h3", "label": "Small" },
            { "value": "h2", "label": "Medium" },
            { "value": "h1", "label": "Large" },
            { "value": "hd2", "label": "Extra large" }
          ]
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "inventory_threshold",
          "label": "Low inventory threshold",
          "min": 0, "max": 100, "step": 1, "default": 10
        },
        {
          "type": "checkbox",
          "id": "show_inventory_quantity",
          "label": "Show inventory count",
          "default": true
        }
      ]
    },
    {
      "type": "badges",
      "name": "Badges and tags",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker type",
          "default": "button",
          "options": [
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "button", "label": "Buttons / swatches" }
          ]
        },
        {
          "type": "select",
          "id": "swatch_type",
          "label": "Swatch display",
          "default": "variant_image",
          "options": [
            { "value": "color_swatch", "label": "Color swatch" },
            { "value": "variant_image", "label": "Variant image" },
            { "value": "shopify_swatch", "label": "Shopify swatch" },
            { "value": "text", "label": "Text" }
          ]
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "circle",
          "options": [
            { "value": "standard", "label": "Standard" },
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" }
          ]
        },
        {
          "type": "range",
          "id": "button_size",
          "label": "Swatch size",
          "min": 20, "max": 128, "step": 2, "default": 60, "unit": "px"
        },
        {
          "type": "text",
          "id": "size_title",
          "label": "Size option name",
          "default": "Size"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity_selector",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "Show gift card recipient form",
          "default": true
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collapsible row"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check-circle",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "check-circle", "label": "Check" },
            { "value": "truck", "label": "Truck" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "package", "label": "Package" },
            { "value": "star-four", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "gift", "label": "Gift" }
          ]
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "checkbox",
