    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "prestige_price",
      "name": "Prestige Price",
      "limit": 1
    },
    {
      "type": "prestige_shape_picker",
      "name": "Shape Picker",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
