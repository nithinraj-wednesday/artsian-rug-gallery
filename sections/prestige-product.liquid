        { "type": "range", "id": "item_padding_horizontal", "label": "Item padding (horizontal)", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 20 },
        { "type": "range", "id": "item_border_width", "label": "Item border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
        { "type": "color", "id": "item_border_color", "label": "Item border color", "default": "#d0d0d0" },
        { "type": "range", "id": "item_border_radius", "label": "Item border radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
        { "type": "color", "id": "item_background_color", "label": "Item background", "default": "#ffffff" },
        { "type": "header", "content": "Icons" },
        { "type": "range", "id": "icon_size", "label": "Icon size", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 10 },
        { "type": "range", "id": "icon_gap", "label": "Gap from text", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 8 },
        { "type": "range", "id": "icon_border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
        { "type": "color", "id": "icon_border_color", "label": "Border color", "default": "#000000" },
        { "type": "header", "content": "Typography" },
        { "type": "range", "id": "label_size", "label": "Label size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 11 },
        { "type": "select", "id": "label_weight", "label": "Label weight", "options": [{ "value": "400", "label": "Normal" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "400" },
        { "type": "select", "id": "label_transform", "label": "Label text case", "options": [{ "value": "none", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" }], "default": "uppercase" },
