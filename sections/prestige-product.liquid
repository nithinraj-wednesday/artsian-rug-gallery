      "name": "Prestige Add to Cart",
      "limit": 1
    },
    {
      "type": "prestige_sample_atc",
      "name": "Sample Add to Cart",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Order a Sample"
        },
        {
          "type": "text",
          "id": "sample_note",
          "label": "Note below button",
          "default": "Free shipping on samples"
        }
      ]
    },
    {
      "type": "fabric_specs",
      "name": "Fabric Specifications",
      "limit": 1,
      "settings": [
        { "type": "header", "content": "Layout" },
        { "type": "range", "id": "gap", "label": "Gap between items", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 32 },
        { "type": "header", "content": "Container style" },
        { "type": "range", "id": "padding", "label": "Padding", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 16 },
        { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 0 },
        { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
