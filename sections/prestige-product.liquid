        { "value": "grid-mix", "label": "Grid" },
        { "value": "vertical-carousel", "label": "Vertical carousel" }
      ]
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Image size",
      "default": "large",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "label": "Mobile thumbnails",
      "default": "hide",
      "options": [
        { "value": "show", "label": "Show" },
