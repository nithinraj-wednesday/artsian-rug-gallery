{% comment %}
  Max/Min Size Dialog Component

  A reusable dialog component for displaying maximum and minimum dimensions
  for rectangular and round rugs.

  Usage:
  {% render 'max-min-size-dialog' %}

  Required JavaScript variables (must be defined in parent):
  - minRectLengthLabel
  - minRectLengthValue
  - minRectWidthLabel
  - minRectWidthValue
  - minRoundDiameterLabel
  - minRoundDiameterValue
  - maxRectLengthLabel
  - maxRectLengthValue
  - maxRectWidthLabel
  - maxRectWidthValue
  - maxRoundDiameterLabel
  - maxRoundDiameterValue
{% endcomment %}

<a href="#" id="openMaxMinInfo">Min/max size info</a>

<dialog class="max-min-dialog" id="max-min-dialog">
  <div class="max-min-modal-content">
    <div class="max-min-modal-header">
      <h2>{{ product.title }} Size Info</h2>
      <button class="close-max-min-modal" aria-label="Close">&times;</button>
    </div>
    <div class="max-min-modal-body">

      <!-- Rectangle section -->
      <div class="rectangle-info size-section">
