<style>
  #openMaxMinInfo {
    text-decoration: underline;
    font-size: 14px;
    margin: 0.5rem 0rem;
    color: #7b7a7a;
  }

  .max-min-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 1.5rem;
    width: min(620px, 92vw);
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    border: none;
    border-radius: 8px;
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translate(-50%, -48%); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
  }

  .max-min-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    border-bottom: 1px solid #e8e8e8;
    padding-bottom: 0.75rem;
  }

  .max-min-modal-header h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    color: #111;
    letter-spacing: 0.02em;
  }

  .close-max-min-modal {
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: #888;
    cursor: pointer;
    padding: 0 0 0 0.5rem;
  }

  .close-max-min-modal:hover {
    color: #111;
  }

  /* Section row: two cards side by side */
  .size-section {
    display: flex;
    gap: 12px;
    margin-bottom: 1rem;
  }

  .size-section:last-child {
    margin-bottom: 0;
  }

  /* Individual card */
  .size-card {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    background: #f8f8f8;
    border-radius: 6px;
    padding: 12px;
  }

  /* SVG wrapper with dimension labels */
  .svg-area {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .dim-top {
    font-size: 12px;
    color: #555;
    margin-bottom: 4px;
    margin-left: 24px; /* offset by dim-left width to center over SVG */
    display: block;
    text-align: center;
    min-height: 14px;
  }

  .svg-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .dim-left {
    font-size: 12px;
    color: #555;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 20px;
    gap: 1px;
    line-height: 1.2;
  }

  .svg-area--round {
    align-items: center;
  }

  .dim-diameter {
    font-size: 12px;
    color: #555;
    margin-top: 4px;
    display: block;
    text-align: center;
    min-height: 14px;
  }

  /* Text labels */
  .size-desc {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .size-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 6px;
    color: #111;
  }

  .size-label {
    font-size: 12px;
    font-weight: 700;
    margin: 0;
    color: #333;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 4px;
  }

  .size-value {
    font-size: 12px;
    font-weight: 400;
    margin: 0;
    color: #444;
  }

  .round-info {
    display: none;
  }

  @media screen and (max-width: 480px) {
    .size-card {
      flex-direction: column;
      align-items:center;
      gap: 8px;
    }

    .size-section {
      flex-direction: column;
    }
    .max-min-dialog{
      top:80%;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    document.addEventListener('DOMContentLoaded', function () {
      const modal = document.getElementById('max-min-dialog');
      const btn = document.getElementById('openMaxMinInfo');
      const closeBtn = document.querySelector('.close-max-min-modal');

      if (btn && modal && closeBtn) {
        btn.onclick = function (event) {
          event.preventDefault();
          modal.showModal();
        };

        closeBtn.onclick = function () {
          modal.close();
        };

        window.addEventListener('click', function (event) {
          if (event.target === modal) {
            modal.close();
          }
        });
      }
    });

    window.updateMaxMinDialogValues = function (selectedVariant) {
      if (!selectedVariant) return;

      const minRectLengthLabel = document.getElementById('min-rect-length-value');
      const minRectLengthValue = document.getElementById('min-length-value');
      const minRectWidthLabel = document.getElementById('min-rect-width-value');
      const minRectWidthValue = document.getElementById('min-width-value');
      const minRoundDiameterLabel = document.getElementById('min-round-diameter-value');
      const minRoundDiameterValue = document.getElementById('min-diameter-value');
      const maxRectLengthLabel = document.getElementById('max-rect-length-value');
      const maxRectLengthValue = document.getElementById('max-length-value');
      const maxRectWidthLabel = document.getElementById('max-rect-width-value');
      const maxRectWidthValue = document.getElementById('max-width-value');
      const maxRoundDiameterLabel = document.getElementById('max-round-diameter-value');
      const maxRoundDiameterValue = document.getElementById('max-diameter-value');

      function convertToFeetAndInches(totalInches) {
        if (totalInches < 1) return { maxFeet: 0, maxInch: 0 };
        const feet = Math.floor(totalInches / 12);
        const inches = totalInches % 12 < 1 ? 0 : totalInches % 12;
        return { maxFeet: feet, maxInch: inches };
      }

      if (minRectLengthLabel) minRectLengthLabel.innerHTML = "↑<br>6'<br>↓";
      if (minRectLengthValue) minRectLengthValue.innerHTML = '6 feet';
      if (minRoundDiameterLabel) minRoundDiameterLabel.innerHTML = "← 3' →";
      if (minRoundDiameterValue) minRoundDiameterValue.innerHTML = '3 feet';
      if (minRectWidthLabel) minRectWidthLabel.innerHTML = "← 2' →";
      if (minRectWidthValue) minRectWidthValue.innerHTML = '2 feet';

      if (selectedVariant.max_diameter) {
        const { maxFeet, maxInch } = convertToFeetAndInches(selectedVariant.max_diameter);
        if (maxRoundDiameterLabel) maxRoundDiameterLabel.innerHTML = maxInch > 0 ? `← ${maxFeet}' ${maxInch}" →` : `← ${maxFeet}' →`;
        if (maxRoundDiameterValue) maxRoundDiameterValue.innerHTML = maxInch > 0 ? `${maxFeet} feet ${maxInch} inches` : `${maxFeet} feet`;
      }

      if (selectedVariant.max_length) {
        const { maxFeet, maxInch } = convertToFeetAndInches(selectedVariant.max_length);
        if (maxRectLengthLabel) maxRectLengthLabel.innerHTML = maxInch > 0 ? `↑<br>${maxFeet}' ${maxInch}"<br>↓` : `↑<br>${maxFeet}'<br>↓`;
        if (maxRectLengthValue) maxRectLengthValue.innerHTML = maxInch > 0 ? `${maxFeet} feet ${maxInch} inches` : `${maxFeet} feet`;
      }

      if (selectedVariant.max_width) {
        const { maxFeet, maxInch } = convertToFeetAndInches(selectedVariant.max_width);
        if (maxRectWidthLabel) maxRectWidthLabel.innerHTML = maxInch > 0 ? `← ${maxFeet}' ${maxInch}" →` : `← ${maxFeet}' →`;
        if (maxRectWidthValue) maxRectWidthValue.innerHTML = maxInch > 0 ? `${maxFeet} feet ${maxInch} inches` : `${maxFeet} feet`;
      }
    };
  })();
</script>
