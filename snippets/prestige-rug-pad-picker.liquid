{% comment %}
  Prestige Rug Pad Picker Snippet
  This snippet adds a radio button picker for selecting rug pads for prestige products.
{% endcomment %}

{%- assign product_form_id = product_form_id | default: 'product-form' -%}

<div class="prestige-accordion-section">
  <details class="prestige-accordion">
    <summary class="prestige-accordion-header">
      <h3 class="prestige-accordion-title">Rug Pad<span id="value-of-type" class="prestige-selected-value"></span></h3>
      <div class="prestige-accordion-header-right">
        {% comment %}
          <span class="tooltip" title="Rug Pad Info">
            {% render 'info-icon' %}
            <span class="tooltip-text">
              <p>The STARK Hold Rug Pad is our standard rug pad we recommend for all spaces.</p>
            </span>
          </span>
        {% endcomment %}
        <svg
          class="prestige-accordion-icon"
          width="12"
          height="8"
          viewBox="0 0 12 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </summary>

    <div class="prestige-accordion-content">
      <div class="rug-pad-error rug-pad-error-hide" id="rug-pad-error">Rug pad field is required</div>

      <input type="hidden" name="properties[Rug Pad]" form="{{product_form_id}}">
      <input type="hidden" name="properties[_padhandler]" form="{{product_form_id}}">

      <div class="prestige-options-container">
        {% if shop.metaobjects.rug_pad.values %}
          {% assign rug_pads = shop.metaobjects.rug_pad.values | sort: 'updated_at' | reverse %}
          <div class="rug-pad-options">
            <!-- None Option -->
            <label class="rug-pad-option active" data-rug-pad-name="None">
              <input
                type="radio"
                value="none"
                class="rug-pad-radio"
                form="{{product_form_id}}"
                checked
              >
              <span class="rug-pad-label">None</span>
              <div
                class="rug-pad-price"
                data-price-value="0"
                data-calculated-price="0"
              >
                $0.00
              </div>
            </label>
            {% for rug_pad in rug_pads %}
              {% unless rug_pad.type.value == 'None' or rug_pad.type.value == 'none' %}
                <label class="rug-pad-option" data-rug-pad-name="{{ rug_pad.type.value }}">
                  <input
                    type="radio"
                    value="{{ rug_pad.type.value | handleize }}"
                    class="rug-pad-radio"
                    form="{{product_form_id}}"
                  >
                  <span class="rug-pad-label">{{ rug_pad.type.value }}</span>
                  <div
                    class="rug-pad-price"
                    data-price-value="{{ rug_pad.price.value }}"
                    data-calculated-price="0"
                  >
                    $ {{ rug_pad.price.value }}
                  </div>
                </label>
              {% endunless %}
            {% endfor %}
          </div>
        {% else %}
          <p class="center">No rug pads available</p>
        {% endif %}
      </div>
    </div>
  </details>
</div>

<style>
  /* Accordion Styles */
  .prestige-accordion-section {
    margin-bottom: 16px;
  }

  .prestige-accordion {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    background-color: #fff;
  }

  .prestige-accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .prestige-accordion-header::-webkit-details-marker {
    display: none;
  }

  .prestige-accordion-header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .prestige-accordion-title {
    font-size: 1.6rem;

    text-transform: none;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .prestige-accordion-icon {
    transition: transform 0.3s ease;
    color: #666;
  }

  .prestige-accordion[open] .prestige-accordion-icon {
    transform: rotate(180deg);
  }

  .prestige-accordion-content {
    padding: 0 20px 20px 20px;
  }

  /* Rug Pad Specific Styles */
  .prestige-rug-pad-section {
    border: none;
    padding: 0;
    border-radius: 0;
    background-color: transparent;
  }

  .prestige-section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    {% comment %} margin-bottom: 16px; {% endcomment %}
  }

  .prestige-section-title {
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .prestige-selected-value {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
  }

  .tooltip {
    position: relative;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }

  .tooltip .tooltip-text {
    visibility: hidden;
    width: 240px;
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px;
    border-radius: 5px;
    font-size: 1.2rem;
    line-height: 1.4;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    opacity: 0;
    transition: opacity 0.3s;
    bottom: 150%;
  }

  .tooltip:hover .tooltip-text {
    visibility: visible;
    opacity: 1;
  }

  .prestige-options-container {
    margin-top: 12px;
  }

  .rug-pad-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .rug-pad-option {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 12px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    background-color: #fff;
    cursor: pointer;
    min-width: 140px;
    transition: all 0.2s ease;
  }

  .rug-pad-option:hover {
    border-color: #999;
  }

  .rug-pad-option.active {
    border: 2px solid #000;
    background-color: #f9f9f9;
  }

  .rug-pad-radio {
    display: none !important;
  }

  .rug-pad-label {
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 8px;
  }

  .rug-pad-price {
    font-size: 14px;
    color: #666;
  }

  .rug-pad-error {
    font-size: 1.2rem;
    color: #d32f2f;
    margin-bottom: 12px;
    padding: 8px 12px;
    background-color: #ffebee;
    border-radius: 4px;
    border-left: 3px solid #d32f2f;
  }

  .rug-pad-error-hide {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .rug-pad-options {
      justify-content: center;
    }

    .rug-pad-option {
      flex: 1 1 calc(50% - 6px);
      min-width: 120px;
    }
  }
</style>

<script src="{{ 'currency-divisor.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const rugPadRadios = document.querySelectorAll('.rug-pad-radio');
    const value = document.getElementById('value-of-type');
    const rugPadInput = document.querySelector('input[name="properties[Rug Pad]"]');
    const rugPadHandler = document.querySelector('input[name="properties[_padhandler]"]');
    var currency = '{{shop.currency}}';
    var currencySymbol = '{{ 25 | money | slice: 0, 1 }}';
    let lastSelectedRadio = null;

    rugPadRadios.forEach(function (radio) {
      radio.addEventListener('click', function (event) {
        const shapePickerError = document.getElementById('shape-picker-error');

        if (shapePickerError && !shapePickerError.classList.contains('shape-picker-error-hide')) {
          return;
        }

        const priceItem = document.querySelector('.prestige-price');
        const selectedOption = this.closest('.rug-pad-option');
        const selectedRugPadName = selectedOption.dataset.rugPadName;
        const selectedRugPadHandler = this.value;
        const prevPrice = priceItem ? parseFloat(priceItem.getAttribute('data-dimension-modified-price')) || 0 : 0;
        const dataRugPadPrice = priceItem ? parseFloat(priceItem.getAttribute('data-rug-pad-price')) || 0 : 0;
        const dataRugProtectionPrice = priceItem
          ? parseFloat(priceItem.getAttribute('data-rug-protection-price')) || 0
          : 0;
        const dataSergingPrice = priceItem ? parseFloat(priceItem.getAttribute('data-serging-price')) || 0 : 0;

        document.getElementById('rug-pad-error').classList.add('rug-pad-error-hide');

        const existingRugPadPrice =
          parseFloat(selectedOption.querySelector('.rug-pad-price').getAttribute('data-calculated-price')) || 0;

        if (lastSelectedRadio === this) {
          this.checked = false;
          selectedOption.classList.remove('active');
          value.textContent = '';
          rugPadInput.value = null;
          rugPadHandler.value = '';
          lastSelectedRadio = null;
          if (priceItem) {
            priceItem.setAttribute('data-rug-pad-price', 0);
            updatePriceItem(prevPrice + dataRugProtectionPrice + dataSergingPrice);
          }
        } else {
          document.querySelectorAll('.rug-pad-option').forEach(function (option) {
            option.classList.remove('active');
          });

          selectedOption.classList.add('active');

          // Show value text and set input value
          if (selectedRugPadName.toLowerCase() !== 'none') {
            value.textContent = `: ${selectedRugPadName}`;
            rugPadInput.value = selectedRugPadName;
            rugPadHandler.value = selectedRugPadHandler;
          } else {
            value.textContent = ': None';
            rugPadInput.value = 'None';
            rugPadHandler.value = 'None';
          }

          lastSelectedRadio = this;

          const totalPrice = Math.ceil(prevPrice + dataRugProtectionPrice + existingRugPadPrice + dataSergingPrice);
          if (priceItem) {
            priceItem.setAttribute('data-rug-pad-price', existingRugPadPrice.toFixed(2));
            updatePriceItem(totalPrice);
          }
        }
      });
    });

    function updatePriceItem(totalPrice) {
      const roundedPrice = Math.ceil(totalPrice);
      const priceItem = document.querySelector('.prestige-price');
      if (priceItem) {
        const formattedPrice = new Intl.NumberFormat('en-US', {
          style: 'decimal',
          minimumFractionDigits: 0,
          maximumFractionDigits: 0,
        }).format(roundedPrice);
        priceItem.innerHTML = `${currencySymbol}${formattedPrice}`;
        priceItem.setAttribute('data-modified-price', totalPrice);
      }
    }

    // Initialize default "None" selection display
    const defaultChecked = document.querySelector('.rug-pad-radio:checked');
    if (defaultChecked) {
      const selectedOption = defaultChecked.closest('.rug-pad-option');
      const selectedRugPadName = selectedOption.dataset.rugPadName;
      if (value && selectedRugPadName) {
        value.textContent = selectedRugPadName.toLowerCase() === 'none' ? ': None' : `: ${selectedRugPadName}`;
      }
      // Set default values for None
      if (selectedRugPadName.toLowerCase() === 'none') {
        rugPadInput.value = 'None';
        rugPadHandler.value = 'none';
      }
    }
  });
</script>
