      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"custom-trade-form-wrapper\">\n  {% form 'contact' %}\n    \n    {%- if form.posted_successfully? -%}\n      <div class=\"form-success-message\">\n        <p>Thank you! Your submission has been received.</p>\n      </div>\n    {%- endif -%}\n\n    {{ form.errors | default_errors }}\n\n    <div class=\"form-grid-custom\">\n      <div class=\"form-group-custom half-width\">\n        <label for=\"CustomFormName\">First and Last Name</label>\n        <input type=\"text\" id=\"CustomFormName\" name=\"contact[name]\" value=\"{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}\">\n      </div>\n      \n      <div class=\"form-group-custom half-width\">\n        <label for=\"CustomFormEmail\">Email *</label>\n        <input type=\"email\" id=\"CustomFormEmail\" name=\"contact[email]\" required value=\"{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}\">\n      </div>\n\n      <div class=\"form-group-custom full-width\">\n        <label for=\"CustomFormBusinessInfo\">Business Name and Full Address</label>\n        <input type=\"text\" id=\"CustomFormBusinessInfo\" name=\"contact[business_name_and_address]\">\n      </div>\n\n      <div class=\"form-group-custom full-width\">\n        <label for=\"CustomFormTaxID\">Tax ID for Trade Account</label>\n        <input type=\"text\" id=\"CustomFormTaxID\" name=\"contact[tax_id]\">\n      </div>\n\n      <div class=\"form-group-custom full-width\">\n        <label for=\"CustomFormRetailShipping\">For Retail Access enter full shipping address</label>\n        <input type=\"text\" id=\"CustomFormRetailShipping\" name=\"contact[retail_shipping_address]\">\n      </div>\n    </div>\n\n    <div class=\"form-submit-custom\">\n      <button type=\"submit\" class=\"button btn\">SUBMIT</button>\n    </div>\n\n    <div class=\"recaptcha-disclaimer-custom\">\n      This site is protected by reCAPTCHA and the Google <a href=\"https://policies.google.com/privacy\" target=\"_blank\" rel=\"noopener noreferrer\">Privacy Policy</a> and <a href=\"https://policies.google.com/terms\" target=\"_blank\" rel=\"noopener noreferrer\">Terms of Service</a> apply.\n    </div>\n\n  {% endform %}\n</div>\n\n<style>\n  /* Wrapper to ensure no background color and reset alignment */\n  .custom-trade-form-wrapper {\n    max-width: 800px;\n    margin: 0 auto;\n    font-family: inherit;\n    background: transparent !important;\n    padding: 20px 0;\n  }\n\n  .form-grid-custom {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n  }\n\n  .form-group-custom {\n    display: flex;\n    flex-direction: column;\n    margin-bottom: 25px;\n    text-align: left !important;\n  }\n\n  .form-group-custom.half-width {\n    width: calc(50% - 15px);\n  }\n\n  .form-group-custom.full-width {\n    width: 100%;\n  }\n\n  .form-group-custom label {\n    margin-bottom: 8px;\n    color: #666 !important;\n    font-size: 16px !important;\n    font-weight: 300 !important;\n    text-align: left !important; \n    display: block !important;\n    letter-spacing: normal !important;\n    text-transform: none !important;\n  }\n\n  .form-group-custom input[type=\"text\"],\n  .form-group-custom input[type=\"email\"] {\n    padding: 12px 15px;\n    border: 1px solid #d1d1d1 !important;\n    border-radius: 0 !important;\n    font-size: 16px !important;\n    width: 100%;\n    box-sizing: border-box;\n    outline: none;\n    background-color: #fff !important;\n    box-shadow: none !important;\n  }\n\n  .form-group-custom input:focus {\n    border-color: #999 !important; \n  }\n\n  .form-submit-custom {\n    margin-top: 15px;\n    text-align: left !important;\n  }\n\n  /* Button Styling */\n  .form-submit-custom .button {\n    padding: 12px 35px;\n    border-radius: 2px;\n    border: none;\n    font-size: 16px;\n    cursor: pointer;\n    background-color: #6b5876 !important; \n    color: #ffffff !important; \n    text-transform: uppercase; \n    letter-spacing: 1px; \n    transition: opacity 0.2s ease;\n  }\n\n  .form-submit-custom .button:hover {\n    opacity: 0.8 !important;\n  }\n\n  /* UPDATED: reCAPTCHA Text Styling */\n  .recaptcha-disclaimer-custom {\n    margin-top: 25px;\n    font-size: 14px !important;\n    color: #888888 !important; /* Light grey to match screenshot */\n    text-align: left !important;\n    font-weight: 300 !important;\n    line-height: 1.5;\n  }\n\n  .recaptcha-disclaimer-custom a {\n    color: #888888 !important;\n    text-decoration: underline !important;\n    transition: color 0.2s ease;\n  }\n\n  .recaptcha-disclaimer-custom a:hover {\n    color: #555555 !important; /* Darkens slightly on hover */\n  }\n\n  .form-success-message {\n    padding: 15px;\n    background-color: #d4edda;\n    color: #155724;\n    margin-bottom: 20px;\n    border-radius: 4px;\n    text-align: left;\n  }\n\n  /* Responsive adjustment for mobile screens */\n  @media screen and (max-width: 600px) {\n    .form-group-custom.half-width {\n      width: 100%;\n    }\n  }\n</style>",
